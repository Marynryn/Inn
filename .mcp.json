{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y", "@playwright/mcp@0.0.80",
        "--headless",
        "--isolated",
        "--viewport-size", "1280x800",
        "--user-agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36 Explorer",
        "--allowed-origins", "http://localhost:3100;http://127.0.0.1:3100;https://fonts.googleapis.com;https://fonts.gstatic.com",
        "--output-dir", ".data/explorer-mcp"
      ]
    }
  }
}
