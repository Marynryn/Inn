# Пароль для подписи сессионной куки — длинная случайная строка (32+ символа)
NUXT_SESSION_PASSWORD=

# Папка с базой, эпабами и аватарками. На Railway — примонтированный том
STORAGE_DIR=storage

# Бот, который шлёт главы в канал и подписывает вход через телеграм
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_THREAD_ID=

# Ключ для ручного вызова рассылки
NOTIFY_SECRET=

# Семя для персонажа дня в игре
GAME_SECRET=

# Вход через Google. Клиент заводится в консоли, redirect URI —
# https://<домен>/auth/google и http://localhost:3000/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

NUXT_PUBLIC_SITE_URL=https://taverna-book.com

# Microsoft Clarity — записи сессий и карты кликов. ID проекта из clarity.microsoft.com.
# Ставить только на боевом сервере: локально и в тестах оставить пустым
NUXT_PUBLIC_CLARITY_ID=

# Зеркала сайта за CDN (через запятую): для них настоящий домен берётся из
# X-Forwarded-Host, чтобы вход через Google/Telegram возвращал человека туда же.
# По умолчанию — inn.taverna-book.ru
MIRROR_HOSTS=
